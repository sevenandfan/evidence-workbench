# Copy these names into the current PowerShell process; do not commit a real key.
# Official DeepSeek (default): only DEEPSEEK_API_KEY is required.
DEEPSEEK_API_KEY=replace-locally

# Optional OpenAI-compatible multi-model gateway:
# B2_API_KEY=replace-locally
# Or reference an existing Windows current-user DPAPI blob without copying plaintext:
# B2_DPAPI_KEY_FILE=C:\absolute\path\to\credential.dpapi
# B2_API_BASE_URL=https://your-provider.example/v1
# B2_MODEL=provider-specific-deepseek-model-id
# B2_INPUT_PRICE_CNY_PER_M=2
# B2_CACHE_PRICE_CNY_PER_M=0.04
# B2_OUTPUT_PRICE_CNY_PER_M=8

# Safety controls (defaults shown):
B2_TIMEOUT_SECONDS=45
B2_MAX_OUTPUT_TOKENS=700
